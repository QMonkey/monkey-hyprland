{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 4,
  "fixed-center": true,
  // Left modules
  "modules-left": [
    "hyprland/workspaces"
  ],
  // Center modules
  "modules-center": [
    "clock"
  ],
  // Right modules
  "modules-right": [
    "tray",
    "pulseaudio",
    "battery"
  ],
  // Module configurations
  "hyprland/workspaces": {
    "format": "{name}",
    "format-icons": {
      "active": "",
      "default": ""
    },
    "on-click": "activate",
    // on-scroll-* runs through a shell, so these are hyprctl dispatcher calls:
    // "workspace e+1" is the native dispatcher, while hl.dsp.focus(...) is a
    // Lua-config function name and no hyprctl dispatcher.
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "all-outputs": false,
    "sort-by-number": true,
    "active-only": false
    // Persistent workspaces are the "persistent-workspaces" OBJECT (id => name
    // or "output:N"); the bool this block used to carry was never read.
  },
  "clock": {
    "format": "{:%H:%M  %a %m-%d}",
    "format-alt": "{:%Y-%m-%d %H:%M:%S}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "interval": 1,
    "on-click-right": "gnome-calendar"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " Muted",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pavucontrol"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": {
      "charging": [
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        ""
      ],
      "default": [
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        ""
      ]
    },
    "tooltip-format": "{timeTo}\n{capacity}% - {power}W",
    "interval": 30
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8,
    "show-passive-items": true
  }
}
